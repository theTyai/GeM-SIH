{
  "manifest_version": 3,
  "name": "GeM-Intel Audit Assistant",
  "version": "2.0.0",
  "description": "1-Click Price Intelligence for GeM Procurement.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.gem.gov.in/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
